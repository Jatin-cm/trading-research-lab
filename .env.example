# ==============================================================================
# TRADING RESEARCH LAB (TRL) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your real .env or secrets to Git.
# 2. NEVER put the Supabase service_role key in this file or any frontend code.
# 3. NEVER put live broker or exchange API secrets (Interactive Brokers, Alpaca, 
#    Binance, etc.) in frontend code.
# ==============================================================================

# Supabase Public Frontend Credentials (Safe for client-side)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Set to 'true' to allow simulated demo login when offline or without Supabase keys
VITE_ENABLE_DEMO_AUTH=true
